diff --git a/mm/Kconfig b/mm/Kconfig
index cf782e04749..cf8e98d1170 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -1180,4 +1180,14 @@ config LOCK_MM_AND_FIND_VMA
 
 source "mm/damon/Kconfig"
 
+config MEMFD_ASHMEM_COMPAT
+	bool "Answer Android's ashmem ioctls on memfd files"
+	depends on MEMFD_CREATE && SHMEM
+	help
+	  Android's libcutils uses memfd for shared memory only when the kernel
+	  answers the ashmem ioctls on a memfd; without this it falls back to the
+	  /dev/ashmem driver, which mainline no longer has. Sizes, names and
+	  protection map onto the memfd's size, dentry name and seals. Off unless a
+	  guest kernel runs Android in a container.
+
 endmenu
