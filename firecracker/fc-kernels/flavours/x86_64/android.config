# The android flavour, as the lines it changes in a stem's config. build.sh
# appends them to configs/x86_64/<stem>.config to seed <stem>-android with
# CONFIG_ONLY=1, and fails unless each survives olddefconfig unchanged.
#
# Derived from configs/x86_64/6.1.158-android.config and the config it was seeded
# from, configs/x86_64/6.1.177.config as of the commit before the flavour was added
# (e7b859b30b60d516e2948bf1ce9e3af9da469dea):
#   python3 scripts/flavour_fragment.py <seed> configs/x86_64/6.1.158-android.config
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ANDROID_BINDER_IPC=y
# CONFIG_ARCH_HAS_KEXEC_PURGATORY is not set
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_LSM=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_CRC32=y
CONFIG_CRYPTO_ECHAINIV=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_GF128MUL=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_KDF800108_CTR=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_XATTR=y
