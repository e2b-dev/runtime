CONFIG_INET_IPCOMP=y
CONFIG_INET_RAW_DIAG=y
CONFIG_INET_TUNNEL=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_XFRM_TUNNEL=y
CONFIG_IP6_NF_MATCH_AH=y
