# Platform pins. Embed is released at the platform version once that release
# is tagged, and each Embed release moves these lines to it: the trailing
# marker is what the release tooling rewrites. Everything without a marker is
# pinned by hand.
E2B_API_IMAGE=us-docker.pkg.dev/e2b-artifacts/api/api:v0.14.202609170000-908833e4c12 # x-release-please-version
E2B_DB_MIGRATOR_IMAGE=us-docker.pkg.dev/e2b-artifacts/api/db-migrator:v0.14.202609170000-908833e4c12 # x-release-please-version
E2B_CLIENT_PROXY_IMAGE=us-docker.pkg.dev/e2b-artifacts/client-proxy/client-proxy:v0.3.202609130627-59497eb9134 # x-release-please-version
E2B_CLICKHOUSE_MIGRATOR_IMAGE=us-docker.pkg.dev/e2b-artifacts/clickhouse-migrator/clickhouse-migrator:v0.4.202609130627-59497eb9134 # x-release-please-version
# dashboard-api is a platform image and moves with the release like the api it
# serves; it must come from the same source commit as the api and db-migrator.
E2B_DASHBOARD_API_IMAGE=us-docker.pkg.dev/e2b-artifacts/dashboard-api/dashboard-api:v0.7.202609170000-908833e4c12 # x-release-please-version
# The dashboard has its own release line (github.com/e2b-dev/dashboard) and is
# pinned by hand.
E2B_DASHBOARD_IMAGE=us-docker.pkg.dev/e2b-artifacts/dashboard/dashboard:v0.2.1
E2B_ORCHESTRATOR_VERSION=v0.16.202609212023-35cc85a6c61 # x-release-please-version
# envd has its own release line; the kernel, Firecracker and BusyBox are not
# released here at all. Bumping one adds its checksum row to
# scripts/fetch-artifacts.sh first.
E2B_ENVD_VERSION=v0.9.202609130627-59497eb9134
E2B_KERNEL_VERSION=vmlinux-6.1.177_5008931
E2B_FIRECRACKER_VERSION=v1.14-0.2.0
E2B_BUSYBOX_VERSION=1.36.1
RUNTIME_COMMIT=7278c2a380767c9989da73cf4c04b1af1b32da18

# Optional: pin the team API key the seed inserts, e2b_ plus at least 32 hex characters (openssl rand -hex 16 makes the hex part). Unset, the seed generates one on the first up and keeps it in the seed-state volume; docker compose logs ready prints it. Changing it later rotates the key on the next up.
#TEAM_API_KEY=
# Optional: pin the api's two secrets, 64 hex characters each (openssl rand -hex 32). Unset, the api-secrets one-shot generates both on the first up and keeps them in the seed-state volume; a value here wins for that variable only. Changing one later takes effect when the api is recreated.
#ADMIN_TOKEN=
#SANDBOX_ACCESS_TOKEN_HASH_SEED=
# Optional: the address a browser uses to reach sandbox traffic through client-proxy (port 3002). Unset, the dashboard tells the browser http://localhost:3002, which is right when you open the dashboard on the machine itself or through an SSH tunnel. Opening it from another machine without a tunnel needs that machine's address here, then `up` again.
#E2B_DASHBOARD_HOST=
# Optional: the host:port of an OpenTelemetry collector that api, the orchestrator, client-proxy and dashboard-api send their metrics, traces and logs to over OTLP/gRPC (plaintext). Unset or empty, nothing is exported. 127.0.0.1:4317 is the built-in collector the next line starts; for a collector of your own, put its address here and leave the next line commented. Change either, then `up` again; to stop the built-in collector, comment both lines out and run `docker compose rm -sf otel-collector` before `up`.
#E2B_OTEL_COLLECTOR_GRPC_ENDPOINT=127.0.0.1:4317
# Optional: run the built-in collector (the otel-collector service), which keeps the e2b.* metrics in this stack's ClickHouse for the api's metrics endpoints and the dashboard's charts. Compose reads this variable itself.
#COMPOSE_PROFILES=otel

# The three stack images this package builds, published by the same release;
# tests/pins.bats keeps them in step with kubernetes/kustomization.yaml and
# docker-bake.hcl.
E2B_TOOLS_IMAGE=us-docker.pkg.dev/e2b-artifacts/embed/tools:v0.3.202609120109-ad1cddd091b # x-release-please-version
E2B_NODE_E2B_IMAGE=us-docker.pkg.dev/e2b-artifacts/embed/node-e2b:v0.3.202609120109-ad1cddd091b # x-release-please-version
E2B_SEED_IMAGE=us-docker.pkg.dev/e2b-artifacts/embed/seed:v0.3.202609120109-ad1cddd091b # x-release-please-version
